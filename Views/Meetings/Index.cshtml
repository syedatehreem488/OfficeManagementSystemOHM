@model IEnumerable<OfficeManagementSystem.Models.Meeting>

@{
    ViewData["Title"] = "Meetings";
    bool isAdmin = Context.Session.GetString("IsAdmin") == "Yes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Meetings</h2>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Schedule Meeting</a>
    }
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Description</th>
            <th>Organizer ID</th>
            @if (isAdmin)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.MeetingDate.ToShortDateString()</td>
                <td>@item.Location</td>
                <td>@item.Description</td>
                <td>@item.OrganizerID</td>
                @if (isAdmin)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MeetingID" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.MeetingID" class="btn btn-danger btn-sm"
                           onclick="return confirm('Delete this meeting?')">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
